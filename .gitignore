# Virtual environment
ls/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo

# Environment variables (NEVER commit secrets)
.env

# Uploads and generated files
static/uploads/*
static/generated/*
!static/uploads/.gitkeep
!static/generated/.gitkeep

# FAISS indexes (can be large, regenerable)
faiss_store/*
!faiss_store/.gitkeep

